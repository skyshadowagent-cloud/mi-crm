# Copia este archivo a .env.local. `npx convex dev` rellena estas dos variables automáticamente.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Solo en Railway (no en local): clave de despliegue de producción de Convex.
# Dashboard de Convex → Settings → Deploy keys → Generate production deploy key
# CONVEX_DEPLOY_KEY=
